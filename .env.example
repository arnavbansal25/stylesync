NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=
# Public site origin (OAuth redirects, Stripe return URLs). Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (Netlify): set to your live URL, e.g. https://stylesync-ab.netlify.app — must match InsForge allowed_redirect_urls in insforge.toml.

# YouCam Beauty API (server-side only)
YOUCAM_API_SECRET_KEY=
YOUCAM_API_PUBLIC_KEY=
# Optional override (default: https://yce-api-01.makeupar.com)
# YOUCAM_API_BASE=

# InsForge Stripe subscriptions (server-side; map plan slugs to CLI-created Prices)
# Indian Stripe accounts: use INR recurring Prices (USD = export/international; needs registered business).
# Create with: npx -y @insforge/cli payments stripe prices create --environment test --product <prod_id> --currency inr --unit-amount <paise> --interval month
# STRIPE_PAYMENT_ENV=test or live (set in Netlify / .env.local — do not commit values)
STRIPE_PAYMENT_ENV=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
